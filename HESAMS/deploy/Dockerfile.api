FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY backend/HESAMS.Api/*.csproj ./HESAMS.Api/
RUN dotnet restore HESAMS.Api/HESAMS.Api.csproj
COPY backend/HESAMS.Api/ ./HESAMS.Api/
RUN dotnet publish HESAMS.Api/HESAMS.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "HESAMS.Api.dll"]
